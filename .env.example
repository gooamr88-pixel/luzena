# Build variables for the website. Full explanation: docs/CONFIGURATION.md
#
# Where they live:
#   production server   /var/www/luzenarestaurant.com/shared/site.env  (deploy/site.env.example)
#   test site, locally  .env.staging.local, read by `npm run build:staging` (git-ignored)
# Do not create .env, .env.local or .env.production* in this folder: `npm run build` and the
# browser tests would silently pick them up.
#
# Everything here ends up PUBLIC: values starting VITE_ are compiled into the JavaScript
# that visitors download, and the ordering link is printed on every page. ONLY values that
# are meant to be public belong in this file.
#
# NEVER put the Supabase service-role key, the Clover app secret, the token encryption key
# or any email credential here. Those are Supabase Edge Function secrets
# (see supabase/functions/.env.example).

# Supabase project URL, for example https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Supabase "anon" (publishable) key. Public by design: with row level security enabled and
# no policies it can read and write nothing. The dashboard uses it only to sign owners in.
VITE_SUPABASE_ANON_KEY=

# The restaurant's Clover Online Ordering page: where ORDER NOW on the site's Order Online
# page leads. (Every ORDER ONLINE button on the site leads to that page first.)
# Leave empty to use ordering.url from content/site.json; a value here overrides it. With
# neither set, the Order Online page says "ordering opens soon". The production build
# refuses placeholder addresses.
CLOVER_ORDERING_URL=

# Development only. `npm run dev` sets both of these for you. Never set them on the server:
# the production build refuses VITE_DASHBOARD_DEMO, and CONTENT_PROFILE=sample would
# publish sample photos.
# VITE_DASHBOARD_DEMO=1
# CONTENT_PROFILE=sample
