# Edge Function secrets. Set with:  supabase secrets set --env-file supabase/functions/.env
# NEVER commit the real file and NEVER put any of these in a VITE_* variable.
# Full explanation, with the value for each environment: docs/CONFIGURATION.md
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.

# Origins allowed to call the functions from a browser (comma separated, no trailing slash).
ALLOWED_ORIGINS=https://luzenarestaurant.com,https://www.luzenarestaurant.com

# ---------------------------------------------------------------------------------------
# Clover (Clover Developer Dashboard > Your Apps > App Settings)
# ---------------------------------------------------------------------------------------
# sandbox | na | eu | la.   United States and Canada: na.
# Setting this (with TOKEN_ENCRYPTION_KEY below) is all that "Connect with a Clover API
# token" needs: a restaurant connecting its own Clover account uses a token its owner
# creates in Clover, and no app id or secret. The app id and secret are only for the OAuth
# route, which needs a Clover app that Clover has approved. See CLOVER_INTEGRATION.md.
CLOVER_ENV=sandbox
# Clover calls this the App ID, or the OAuth Client ID.
CLOVER_APP_ID=
# Clover calls this the App Secret, or the OAuth Client Secret.
CLOVER_APP_SECRET=
# Must match the app's Site URL in Clover exactly, including the trailing slash.
CLOVER_REDIRECT_URI=https://luzenarestaurant.com/dashboard/
# The X-Clover-Auth value Clover shows after the webhook URL is verified.
CLOVER_WEBHOOK_AUTH=
# Keep "true". Set to "false" only after sandbox testing shows Clover does not send `state`
# back to the redirect URI (CLOVER_SANDBOX_TEST_PLAN.md, test M-4).
CLOVER_REQUIRE_STATE=true

# 32 random bytes, base64. Encrypts Clover tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a different key in each environment. Losing or changing it makes stored tokens
# unreadable: every restaurant must reconnect Clover.
TOKEN_ENCRYPTION_KEY=

# How old the mirrored menu may be before a public read triggers a background sync.
MENU_SYNC_TTL_SECONDS=300

# Random string. Salts the hash of client IPs used for rate limiting.
IP_HASH_SALT=

# ---------------------------------------------------------------------------------------
# Email. One provider's API key, and the sender every email goes out under: the
# notification of a new application, messages to applicants, invitations to the dashboard
# and the monthly report. With no key, or no EMAIL_FROM, nothing is sent and the dashboard
# says so.
# ---------------------------------------------------------------------------------------
# Brevo: SMTP & API > API keys ("xkeysib-..."). NOT the SMTP key ("xsmtpsib-..."): an Edge
# Function cannot use SMTP. If the key is restricted to authorised IP addresses in Brevo
# (Security > Authorised IPs), switch that off for it: Supabase's addresses are not fixed.
BREVO_API_KEY=
# Resend, used only when BREVO_API_KEY is empty.
RESEND_API_KEY=
# The name applicants see, and an address on a domain (or a sender) verified with the
# provider. A reply an applicant writes goes to the restaurant's recruitment address.
EMAIL_FROM=Luzena Restaurant & Cafe <careers@luzenarestaurant.com>

# ---------------------------------------------------------------------------------------
# The daily schedule (monthly report, clean-up)
# ---------------------------------------------------------------------------------------
# At least 32 random characters. The scheduled-tasks function refuses every call that does
# not carry it, and every call at all while it is empty. Generate with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# The same value goes into the database's Vault: see supabase/schedule-daily-tasks.sql.
# Use a different one in each environment.
CRON_SECRET=

# ---------------------------------------------------------------------------------------
# Job applications. Both must be set before any application is accepted.
# ---------------------------------------------------------------------------------------
# Leave unset until the privacy policy is published. Only the exact value "true" opens it.
JOB_APPLICATIONS_ENABLED=
# Days an application and its CV are kept before both are deleted. THERE IS NO DEFAULT:
# this is the restaurant's decision (with whoever advises it on privacy law), and it must
# match the privacy policy. While it is empty, every application is refused.
JOB_APPLICATION_RETENTION_DAYS=

# Where applications are sent is NOT set here. It is the recruitment_email of the
# restaurant's row in the database: see supabase/provision-restaurant.sql.
