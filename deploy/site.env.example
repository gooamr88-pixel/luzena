# Build variables for the website ON THE SERVER. Copy to
#   /var/www/luzenarestaurant.com/shared/site.env
# and fill in. deploy/deploy.sh reads it before every build.
#
# Everything here ends up PUBLIC: it is compiled into the pages visitors download. No secret
# belongs in this file or anywhere on this server. The Supabase secret key, the Clover app
# secret and the token encryption key are Supabase Edge Function secrets, set from a
# developer machine (supabase/functions/.env.example).

# production | test. The deploy script refuses to build unless VITE_SUPABASE_URL below is
# the Supabase project of this environment.
DEPLOY_ENVIRONMENT=production

# Supabase project URL. Production is the N. California project.
VITE_SUPABASE_URL=https://xqzpuqjrlrxyitjubkqk.supabase.co

# That project's PUBLISHABLE key (sb_publishable_...). Never the secret key.
VITE_SUPABASE_ANON_KEY=

# The restaurant's Clover Online Ordering page. Leave empty until the restaurant provides
# it: every ORDER ONLINE button then stays on the site's own "ordering opens soon" page.
CLOVER_ORDERING_URL=
